# Election Navigator AI — Environment Variables
# Copy this file to .env and fill in your keys

# REQUIRED — Google Gemini API key
# Get it at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL — Enables polling booth map finder
# Enable Maps JavaScript API + Places API + Geocoding API at console.cloud.google.com
GOOGLE_MAPS_API_KEY=your_maps_api_key_here

# OPTIONAL — Enables multilingual responses
# Enable Cloud Translation API at console.cloud.google.com
GOOGLE_TRANSLATE_API_KEY=your_translate_api_key_here
